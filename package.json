{
  "name": "crays-board",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text-summary",
    "start:qa": "expo start --dev-client --port 8090",
    "qa:contracts": "node .qa/verify-screen-contracts.mjs",
    "qa:harness-tests": "node --test .qa/*.test.mjs",
    "qa:welcome": "node .qa/qa-welcome.mjs",
    "qa:venue-selection": "node .qa/qa-venue-selection.mjs",
    "qa:orders": "node .qa/qa-orders.mjs",
    "qa:orders-ladder": "node .qa/qa-orders-ladder.mjs",
    "qa:orders-live-wake": "node .qa/qa-orders-live-wake.mjs",
    "qa:menu": "node .qa/qa-menu.mjs",
    "qa:events": "node .qa/qa-events.mjs",
    "qa:check-in": "node .qa/qa-check-in.mjs",
    "qa:people": "node .qa/qa-people.mjs",
    "qa:invites": "node .qa/qa-invites.mjs",
    "qa:settings": "node .qa/qa-settings.mjs",
    "qa:home": "node .qa/qa-home.mjs",
    "qa:create-venue": "node .qa/qa-create-venue.mjs",
    "qa:relay:bootstrap": "node .qa/relay-bootstrap.mjs",
    "qa:relay:teardown": "node .qa/relay-teardown.mjs",
    "qa:ux-map": "node .qa/build-ux-map.mjs --profile all --allow-missing --out /tmp/crays-board-ux-map-preview",
    "qa:ux-map:phone": "node .qa/build-ux-map.mjs --profile phone --allow-missing --out /tmp/crays-board-ux-map-preview/phone --hub-root /tmp/crays-board-ux-map-preview",
    "qa:ux-map:tablet": "node .qa/build-ux-map.mjs --profile tablet --allow-missing --out /tmp/crays-board-ux-map-preview/tablet --hub-root /tmp/crays-board-ux-map-preview",
    "qa:ux-map:verify": "node .qa/verify-ux-matrix.mjs",
    "qa:device": "scripts/emulator-headless.sh google",
    "qa:device:phone": "scripts/emulator-headless.sh google",
    "qa:device:tablet": "scripts/emulator-headless.sh crays_samsung_tab",
    "qa:all": "node .qa/run-suite.mjs",
    "qa:all:phone": "QA_DEVICE_PROFILE=phone QA_AVD=google node .qa/run-suite.mjs",
    "qa:all:tablet": "QA_DEVICE_PROFILE=tablet QA_AVD=crays_samsung_tab node .qa/run-suite.mjs",
    "qa:battle:phone": "COORDINATOR_URL=http://127.0.0.1:7831 QA_MANAGE_METRO=0 QA_DEVICE_PROFILE=phone QA_AVD=google QA_SCENARIOS=orders-live-wake QA_SCENARIO_RETRIES=0 QA_SKIP_FAST_GATES=1 node .qa/run-suite.mjs",
    "qa:battle:tablet": "COORDINATOR_URL=http://127.0.0.1:7831 QA_MANAGE_METRO=0 QA_DEVICE_PROFILE=tablet QA_AVD=crays_samsung_tab QA_SCENARIOS=orders-live-wake QA_SCENARIO_RETRIES=0 QA_SKIP_FAST_GATES=1 node .qa/run-suite.mjs",
    "qa:review": "node .qa/review.mjs"
  },
  "dependencies": {
    "@candypoets/nipworker": "0.99.11",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "flatbuffers": "25.2.10",
    "nativewind": "^4.2.4",
    "nostr-tools": "^2.24.1",
    "patch-package": "^8.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "agent-device": "0.20.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3",
    "ws": "^8.21.1"
  }
}
